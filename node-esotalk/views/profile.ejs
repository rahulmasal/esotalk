<!DOCTYPE html>
<html>
<head>
<%- include('partials/head') %>
</head>
<body class='forum-index'>
<div id='messages'></div>
<div id='wrapper'>

<%- include('partials/header') %>

<div id='body'>
<div id='body-content'>
<div class='bodyHeader'>
<h1><%= profileUser.username %></h1>
<span class='subText'><%= profileUser.role.charAt(0).toUpperCase() + profileUser.role.slice(1) %> | Reputation: <%= profileUser.reputation %></span>
</div>

<div style='display:flex; gap:20px; align-items:flex-start;'>
  <div style='text-align:center; min-width:100px;'>
    <div class='avatar' style='width:100px; height:100px; font-size:48px; line-height:100px;'>
      <% if (profileUser.avatarUrl) { %>
        <img src='<%= profileUser.avatarUrl %>' style='width:100px; height:100px; border-radius:50%; object-fit:cover;'>
      <% } else { %>
        <%= profileUser.username.charAt(0).toUpperCase() %>
      <% } %>
    </div>
    <div style='margin-top:8px; font-size:85%; color:#888;'>
      <p><strong><%= postCount %></strong> Posts</p>
      <p><strong><%= conversationCount %></strong> Threads</p>
    </div>
    <% if (profileUser.badges && profileUser.badges.length > 0) { %>
      <div style='margin-top:8px;'>
        <% profileUser.badges.forEach(b => { %>
          <span class='badge'><%= b %></span>
        <% }); %>
      </div>
    <% } %>
  </div>

  <div style='flex:1;'>
    <div class='area' style='margin-bottom:15px; padding:15px;'>
      <h3>About</h3>
      <p><%= profileUser.bio || 'This user hasn\'t written a bio yet.' %></p>

      <% if (typeof user !== 'undefined' && user && user.id === profileUser.id) { %>
        <form action='/profile/edit' method='POST' style='margin-top:10px;'>
          <textarea name='bio' rows='3' placeholder='Write something about yourself...' style='width:100%; padding:8px; border:1px solid #ddd; border-radius:3px; box-sizing:border-box;'><%= profileUser.bio || '' %></textarea>
          <button type='submit' class='button' style='margin-top:8px;'>Update Bio</button>
        </form>
        <form action='/profile/avatar' method='POST' enctype='multipart/form-data' style='margin-top:10px;'>
          <input type='file' name='avatar' accept='image/*'>
          <button type='submit' class='button'>Upload Avatar</button>
        </form>
      <% } %>
    </div>

    <% if (typeof user !== 'undefined' && user && user.id !== profileUser.id) { %>
      <a href='/messages/chat/<%= profileUser.id %>' class='button' style='margin-bottom:15px;'>Send Message</a>
    <% } %>

    <div class='area' style='padding:15px;'>
      <h3>Recent Posts</h3>
      <% if (recentPosts.length === 0) { %>
        <p class='subText'>No posts yet.</p>
      <% } %>
      <ul class='list'>
        <% recentPosts.forEach(p => { %>
          <li>
            <p><%= p.content.substring(0, 200) %><%= p.content.length > 200 ? '...' : '' %></p>
            <small class='subText'>
              <%= new Date(p.createdAt).toLocaleDateString() %>
              <% if (p.Conversation) { %> in <a href='/conversation/<%= p.Conversation.slug %>'><%= p.Conversation.title %></a><% } %>
            </small>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>
</div>

</div>
</div>

<%- include('partials/footer') %>

</div>
</body>
</html>
