<!DOCTYPE html>
<html>
<head>
    <meta charset='utf-8'>
    <title><%= title %></title>
    <meta name="description" content="<%= profileUser.username %>'s profile on esoTalk Plus Forum">
    <link rel="stylesheet" href="/css/base.css">
    <style>
        .profile-container { max-width: 800px; margin: 20px auto; padding: 20px; }
        .profile-header { display: flex; align-items: center; gap: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px; border-radius: 12px; margin-bottom: 20px; }
        .profile-avatar { width: 100px; height: 100px; border-radius: 50%; border: 3px solid white; object-fit: cover; }
        .profile-info h2 { margin: 0; }
        .profile-info p { margin: 4px 0; opacity: 0.85; }
        .profile-stats { display: flex; gap: 20px; margin-top: 10px; }
        .profile-stats span { background: rgba(255,255,255,0.2); padding: 4px 12px; border-radius: 20px; font-size: 0.85em; }
        .badge-list { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }
        .badge { background: #ffc107; color: #333; padding: 2px 8px; border-radius: 10px; font-size: 0.75em; font-weight: bold; }
        .section { background: #fff; border-radius: 8px; padding: 20px; margin-bottom: 15px; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }
        .section h3 { margin-top: 0; }
        .post-item { border-bottom: 1px solid #eee; padding: 10px 0; }
        .post-item:last-child { border-bottom: none; }
        .edit-form textarea { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; }
        .btn { padding: 8px 16px; background: #007bff; color: white; border: none; border-radius: 6px; cursor: pointer; }
        .btn-msg { background: #28a745; text-decoration: none; display: inline-block; margin-top: 10px; }
    </style>
</head>
<body class="forum-index">
    <div id='wrapper'>
        <div id='hdr'><div id='hdr-content'><div id='hdr-inner'>
            <h1 id='forumTitle'><a href='/'>esoTalk Plus</a></h1>
            <ul id='mainMenu'><li><a href='/'>Forum</a></li><li><a href='/messages'>✉ Messages</a></li></ul>
        </div></div></div>
        <div id='body'><div id='body-content'>
            <div class="profile-container">
                <div class="profile-header">
                    <img src="<%= profileUser.avatarUrl || '/img/default-avatar.png' %>" class="profile-avatar">
                    <div class="profile-info">
                        <h2><%= profileUser.username %></h2>
                        <p><%= profileUser.role.charAt(0).toUpperCase() + profileUser.role.slice(1) %> | Reputation: ⭐ <%= profileUser.reputation %></p>
                        <div class="profile-stats">
                            <span>📝 <%= postCount %> Posts</span>
                            <span>💬 <%= conversationCount %> Threads</span>
                        </div>
                        <% if (profileUser.badges && profileUser.badges.length > 0) { %>
                            <div class="badge-list">
                                <% profileUser.badges.forEach(b => { %>
                                    <span class="badge"><%= b %></span>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <% if (user && user.id !== profileUser.id) { %>
                    <a href="/messages/chat/<%= profileUser.id %>" class="btn btn-msg">✉ Send Message</a>
                <% } %>

                <div class="section">
                    <h3>About</h3>
                    <p><%= profileUser.bio || 'This user hasn\'t written a bio yet.' %></p>

                    <% if (user && user.id === profileUser.id) { %>
                        <form action="/profile/edit" method="POST" class="edit-form" style="margin-top: 10px;">
                            <textarea name="bio" rows="3" placeholder="Write something about yourself..."><%= profileUser.bio || '' %></textarea>
                            <button type="submit" class="btn" style="margin-top: 8px;">Update Bio</button>
                        </form>
                        <form action="/profile/avatar" method="POST" enctype="multipart/form-data" style="margin-top: 15px;">
                            <input type="file" name="avatar" accept="image/*">
                            <button type="submit" class="btn">Upload Avatar</button>
                        </form>
                    <% } %>
                </div>

                <div class="section">
                    <h3>Recent Posts</h3>
                    <% if (recentPosts.length === 0) { %>
                        <p>No posts yet.</p>
                    <% } %>
                    <% recentPosts.forEach(p => { %>
                        <div class="post-item">
                            <p><%= p.content.substring(0, 200) %><%= p.content.length > 200 ? '...' : '' %></p>
                            <small style="color: #888;"><%= new Date(p.createdAt).toLocaleDateString() %> 
                            <% if (p.Conversation) { %> in <a href="/conversation/<%= p.Conversation.slug %>"><%= p.Conversation.title %></a><% } %></small>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div></div>
    </div>
</body>
</html>
