<!DOCTYPE html>
<html>
<head>
<%- include('partials/head') %>
</head>
<body class='forum-index'>
<div id='messages'></div>
<div id='wrapper'>

<%- include('partials/header') %>

<div id='body'>
<div id='body-content'>

<div class='sheet active' style='margin:40px auto; width:470px;'>
  <h3 style='padding:10px 15px;'>Reset Your Password</h3>
  <div class='section'>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class='message warning'><%= error %></div>
    <% } %>
    <form action='/auth/reset-password/<%= token %>' method='POST'>
      <ul class='form'>
        <li>
          <label>New Password</label>
          <input type='password' name='password' placeholder='New Password' required>
        </li>
        <li>
          <label>Confirm</label>
          <input type='password' name='confirmPassword' placeholder='Confirm New Password' required>
        </li>
      </ul>
      <div class='buttons'>
        <button type='submit' class='button submit' style='background:#364159; color:#fff;'>Reset Password</button>
      </div>
    </form>
  </div>
</div>

</div>
</div>

<%- include('partials/footer') %>

</div>
</body>
</html>
