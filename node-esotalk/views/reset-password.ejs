<!DOCTYPE html>
<html>
<head>
    <meta charset='utf-8'>
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/base.css">
    <style>
        .auth-container { max-width: 400px; margin: 40px auto; padding: 20px; background: #fff; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); text-align: center; }
        .auth-btn { display: block; width: 100%; padding: 10px; margin-bottom: 10px; border-radius: 4px; color: white; border: none; font-weight: bold; cursor: pointer; }
        .btn-local { background-color: #28a745; }
        input[type="password"] { width: 100%; padding: 10px; margin-bottom: 10px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        .error-msg { color: #dc3545; margin-bottom: 15px; font-weight: bold; }
    </style>
</head>
<body class="forum-index">
    <div id='wrapper'>
        <div id='hdr'><div id='hdr-content'><div id='hdr-inner'><h1 id='forumTitle'><a href='/'>esoTalk Plus</a></h1></div></div></div>
        <div id='body'><div id='body-content'>
            <div class="auth-container">
                <h2>Reset Your Password</h2>
                <% if (typeof error !== 'undefined') { %><div class="error-msg"><%= error %></div><% } %>
                <form action="/auth/reset-password/<%= token %>" method="POST">
                    <input type="password" name="password" placeholder="New Password" required>
                    <input type="password" name="confirmPassword" placeholder="Confirm New Password" required>
                    <button type="submit" class="auth-btn btn-local">Reset Password</button>
                </form>
            </div>
        </div></div>
    </div>
</body>
</html>
