<!DOCTYPE html>
<html>
<head>
<%- include('partials/head') %>
</head>
<body class='forum-index'>
<div id='messages'></div>
<div id='wrapper'>

<%- include('partials/header') %>

<div id='body'>
<div id='body-content'>
<div class='bodyHeader'>
<h1>Notifications</h1>
</div>

<% if (notifications.length === 0) { %>
  <div class='area'>
    <p style='text-align:center; color:#888; padding:20px;'>No notifications yet!</p>
  </div>
<% } else { %>
  <ul class='notificationsList list'>
    <% notifications.forEach(n => { %>
      <li class='<%= n.isRead ? '' : 'unread' %>'>
        <a href='<%= (n.link && (n.link.startsWith('/') || n.link.startsWith("http"))) ? n.link : '#' %>'>
          <img src='<%= (n.actor && n.actor.avatarUrl) ? n.actor.avatarUrl : "/img/default-avatar.png" %>' class='avatar thumb'>
          <span class='action'><%= n.message %></span>
          <small class='subText'><%= new Date(n.createdAt).toLocaleString() %></small>
        </a>
      </li>
    <% }); %>
  </ul>
  <% if (notifications.length > 0) { %>
    <form action='/notifications/clear' method='POST' style='margin-top:10px;'>
      <button class='button'>Clear All</button>
    </form>
  <% } %>
<% } %>

</div>
</div>

<%- include('partials/footer') %>

</div>
</body>
</html>
