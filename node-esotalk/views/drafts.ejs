<!DOCTYPE html>
<html>
<head>
<%- include('partials/head') %>
</head>
<body class='forum-index'>
<div id='messages'></div>
<div id='wrapper'>

<%- include('partials/header') %>

<div id='body'>
<div id='body-content'>
<div class='bodyHeader'>
<h1>My Drafts</h1>
</div>

<% if (drafts.length === 0) { %>
  <div class='area'>
    <p style='text-align:center; color:#888; padding:20px;'>No drafts saved.</p>
  </div>
<% } else { %>
  <ul class='list'>
    <% drafts.forEach(d => { %>
      <li style='padding:12px;'>
        <h3 style='margin:0 0 4px;'><%= d.title || 'Untitled Draft' %></h3>
        <p style='color:#666; font-size:85%; margin:0;'><%= d.content ? d.content.substring(0, 150) + '...' : '' %></p>
        <small class='subText'>Last saved: <%= new Date(d.updatedAt).toLocaleString() %></small>
      </li>
    <% }); %>
  </ul>
<% } %>

</div>
</div>

<%- include('partials/footer') %>

</div>
</body>
</html>
