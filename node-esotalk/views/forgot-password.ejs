<!DOCTYPE html>
<html>
<head>
<%- include('partials/head') %>
</head>
<body class='forum-index'>
<div id='messages'></div>
<div id='wrapper'>

<%- include('partials/header') %>

<div id='body'>
<div id='body-content'>

<div class='sheet active' style='margin:40px auto; width:470px;'>
  <h3 style='padding:10px 15px;'>Forgot Password</h3>
  <div class='section'>
    <p style='color:#888; margin-bottom:10px;'>Enter your email and we'll send you a reset link.</p>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class='message warning'><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class='message success'><%= success %></div>
    <% } %>
    <form action='/auth/forgot-password' method='POST'>
      <ul class='form'>
        <li>
          <label>Email</label>
          <input type='email' name='email' placeholder='Email Address' required autofocus>
        </li>
      </ul>
      <div class='buttons'>
        <button type='submit' class='button submit' style='background:#364159; color:#fff;'>Send Reset Link</button>
        <small><a href='/auth/login'>Back to Login</a></small>
      </div>
    </form>
  </div>
</div>

</div>
</div>

<%- include('partials/footer') %>

</div>
</body>
</html>
