<!DOCTYPE html>
<html>
<head>
    <meta charset='utf-8'>
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/base.css">
    <style>
        .auth-container { max-width: 400px; margin: 40px auto; padding: 20px; background: #fff; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); text-align: center; }
        .auth-btn { display: block; width: 100%; padding: 10px; margin-bottom: 10px; border-radius: 4px; color: white; border: none; font-weight: bold; cursor: pointer; }
        .btn-local { background-color: #007bff; }
        input[type="email"] { width: 100%; padding: 10px; margin-bottom: 10px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        .error-msg { color: #dc3545; margin-bottom: 15px; font-weight: bold; }
        .success-msg { color: #28a745; margin-bottom: 15px; font-weight: bold; }
    </style>
</head>
<body class="forum-index">
    <div id='wrapper'>
        <div id='hdr'><div id='hdr-content'><div id='hdr-inner'><h1 id='forumTitle'><a href='/'>esoTalk Plus</a></h1></div></div></div>
        <div id='body'><div id='body-content'>
            <div class="auth-container">
                <h2>Forgot Password</h2>
                <p>Enter your email and we'll send you a reset link.</p>
                <% if (typeof error !== 'undefined') { %><div class="error-msg"><%= error %></div><% } %>
                <% if (typeof success !== 'undefined') { %><div class="success-msg"><%= success %></div><% } %>
                <form action="/auth/forgot-password" method="POST">
                    <input type="email" name="email" placeholder="Email Address" required autofocus>
                    <button type="submit" class="auth-btn btn-local">Send Reset Link</button>
                </form>
                <a href="/auth/login" style="display:block; margin-top:15px; color:#007bff;">← Back to Login</a>
            </div>
        </div></div>
    </div>
</body>
</html>
