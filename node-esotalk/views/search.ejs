<!DOCTYPE html>
<html>
<head>
<%- include('partials/head') %>
</head>
<body class='forum-index'>
<div id='messages'></div>
<div id='wrapper'>

<%- include('partials/header') %>

<div id='body'>
<div id='body-content'>
<div class='bodyHeader'>
<h1>Search</h1>
</div>

<div class='area' style='margin-bottom:20px;'>
<form action='/search' method='GET' class='search' style='float:none; padding:10px;'>
  <i class='icon-search' style='margin-top:8px;'></i>
  <input type='text' name='q' value='<%= query %>' placeholder='Search threads and posts...' autofocus style='width:100%; padding:8px 25px 8px 25px;'>
</form>
</div>

<% if (typeof results !== 'undefined' && results && results.conversations && results.conversations.length > 0) { %>
  <div class='area'>
    <h3 style='padding:10px 0;'>Threads (<%= results.conversations.length %>)</h3>
    <ul class='list'>
      <% results.conversations.forEach(c => { %>
        <li>
          <a href='/conversation/<%= c.slug %>'><strong><%= c.title %></strong></a>
          <span class='action'>by <span class='name'><%= c.startUser ? c.startUser.username : 'Unknown' %></span></span>
        </li>
      <% }); %>
    </ul>
  </div>
<% } %>

<% if (typeof results !== 'undefined' && results && results.posts && results.posts.length > 0) { %>
  <div class='area'>
    <h3 style='padding:10px 0;'>Posts (<%= results.posts.length %>)</h3>
    <ul class='list'>
      <% results.posts.forEach(p => { %>
        <li>
          <a href='/conversation/<%= p.Conversation ? p.Conversation.slug : '#' %>'><strong><%= p.Conversation ? p.Conversation.title : 'Unknown Thread' %></strong></a>
          <p style='color:#888; font-size:85%; margin:4px 0 0;'><%= p.content.substring(0, 150) %>...</p>
          <small class='subText'>by <%= p.User ? p.User.username : 'Unknown' %></small>
        </li>
      <% }); %>
    </ul>
  </div>
<% } %>

<% if (query && (!results || ((!results.conversations || results.conversations.length === 0) && (!results.posts || results.posts.length === 0)))) { %>
  <div class='area'>
    <p style='text-align:center; color:#888; padding:20px;'>No results found for "<%= query %>"</p>
  </div>
<% } %>

</div>
</div>

<%- include('partials/footer') %>

</div>
</body>
</html>
