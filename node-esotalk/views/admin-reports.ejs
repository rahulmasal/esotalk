<!DOCTYPE html>
<html>
<head>
<%- include('partials/head') %>
<style>
    .report-card { background: #fff; border-left: 4px solid #ffc107; padding: 15px; margin-bottom: 15px; border-radius: 3px; border: 1px solid #e1e1e1; }
    .report-card.reviewed { border-left-color: #28a745; }
    .report-card.dismissed { border-left-color: #888; }
    .report-meta { color: #888; font-size: 85%; margin-bottom: 8px; }
    .report-content { background: #f8f8f8; padding: 10px; border-radius: 3px; margin: 10px 0; }
</style>
</head>
<body class='forum-index'>
<div id='messages'></div>
<div id='wrapper'>

<%- include('partials/header') %>

<div id='body'>
<div id='body-content'>
<div class='bodyHeader'>
<h1>Reports Queue</h1>
<a href='/admin'>Back to Admin</a>
</div>

<% if (reports.length === 0) { %>
    <div class='area'>
        <p style='text-align:center; color:#888; padding:20px;'>No reports to review.</p>
    </div>
<% } %>

<% reports.forEach(report => { %>
    <div class='report-card <%= report.status %>'>
        <div class='report-meta'>
            Reported by <strong><%= report.reporter ? report.reporter.username : 'Unknown' %></strong>
            | Status: <strong><%= report.status %></strong>
            | <%= report.createdAt %>
        </div>
        <p><strong>Reason:</strong> <%= report.reason %></p>
        <% if (report.details) { %><p><%= report.details %></p><% } %>
        <% if (report.Post && report.Post.content) { %>
            <div class='report-content'><%= report.Post.content.substring(0, 200) %>...</div>
        <% } else if (report.PostId) { %>
            <div class='report-content'><em>[Post content unavailable or deleted]</em></div>
        <% } %>
        <% if (report.status === 'pending') { %>
            <form action='/admin/reports/<%= report.id %>/status' method='POST' style='display:inline;'>
                <input type='hidden' name='status' value='reviewed'>
                <button class='button'>Mark Reviewed</button>
            </form>
            <form action='/admin/reports/<%= report.id %>/status' method='POST' style='display:inline;'>
                <input type='hidden' name='status' value='dismissed'>
                <button class='button'>Dismiss</button>
            </form>
        <% } %>
    </div>
<% }); %>

</div>
</div>

<%- include('partials/footer') %>

</div>
</body>
</html>
