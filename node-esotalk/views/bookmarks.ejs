<!DOCTYPE html>
<html>
<head>
<%- include('partials/head') %>
</head>
<body class='forum-index'>
<div id='messages'></div>
<div id='wrapper'>

<%- include('partials/header') %>

<div id='body'>
<div id='body-content'>
<div class='bodyHeader'>
<h1>My Bookmarks</h1>
</div>

<% if (bookmarks.length === 0) { %>
  <div class='area'>
    <p style='text-align:center; color:#888; padding:20px;'>No bookmarks saved yet.</p>
  </div>
<% } else { %>
  <ul class='list'>
    <% bookmarks.forEach(b => { %>
      <li style='display:flex; justify-content:space-between; align-items:center;'>
        <a href='/conversation/<%= b.Conversation ? b.Conversation.slug : '#' %>'><%= b.Conversation ? b.Conversation.title : 'Unknown' %></a>
        <button class='button' onclick="fetch('/bookmark/<%= b.conversationId %>', {method:'DELETE'}).then(()=>location.reload())">Remove</button>
      </li>
    <% }); %>
  </ul>
<% } %>

</div>
</div>

<%- include('partials/footer') %>

</div>
</body>
</html>
