<!DOCTYPE html>
<html>
<head>
<%- include('partials/head') %>
</head>
<body class='forum-index'>
<div id='messages'></div>
<div id='wrapper'>

<%- include('partials/header') %>

<div id='body'>
<div id='body-content'>
<div class='bodyHeader'>
<h1>Messages</h1>
</div>

<% if (conversations.length === 0) { %>
  <div class='area'>
    <p style='text-align:center; color:#888; padding:20px;'>No messages yet. Start a conversation from a user's profile!</p>
  </div>
<% } else { %>
  <ul class='list'>
    <% conversations.forEach(conv => { %>
      <li>
        <a href='/messages/chat/<%= conv.partner.id %>' style='display:flex; align-items:center; gap:12px; padding:12px; text-decoration:none; color:inherit;'>
          <img src='<%= conv.partner.avatarUrl || "/img/default-avatar.png" %>' class='avatar thumb' style='width:40px; height:40px; line-height:40px; font-size:20px;'>
          <div style='flex:1;'>
            <strong><%= conv.partner.username %></strong>
            <p style='margin:2px 0 0; color:#888; font-size:85%;'><%= conv.lastMessage.content.substring(0, 60) %>...</p>
          </div>
          <% if (conv.unread > 0) { %>
            <span class='badge'><%= conv.unread %></span>
          <% } %>
        </a>
      </li>
    <% }); %>
  </ul>
<% } %>

</div>
</div>

<%- include('partials/footer') %>

</div>
</body>
</html>
