<!DOCTYPE html>
<html>
<head>
<%- include('partials/head') %>
</head>
<body class='forum-index'>
<div id='messages'></div>
<div id='wrapper'>

<%- include('partials/header') %>

<div id='body'>
<div id='body-content'>

<div class='sheet active' style='margin:40px auto; width:470px;'>
  <h3 style='padding:10px 15px;'>Verify Your Email</h3>
  <div class='section' style='text-align:center;'>
    <p style='color:#888;'>We sent a 6-digit code to <strong><%= email %></strong></p>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class='message warning'><%= error %></div>
    <% } %>
    <form action='/auth/verify-otp' method='POST' style='margin-top:15px;'>
      <input type='text' name='code' placeholder='000000' maxlength='6' required autofocus style='text-align:center; letter-spacing:2px; font-size:1.2em; width:200px;'>
      <div class='buttons' style='margin-top:15px;'>
        <button type='submit' class='button submit' style='background:#364159; color:#fff;'>Confirm Account</button>
      </div>
    </form>
    <form action='/auth/resend-otp' method='POST' style='margin-top:10px;'>
      <button type='submit' class='button'>Resend Code</button>
    </form>
  </div>
</div>

</div>
</div>

<%- include('partials/footer') %>

</div>
</body>
</html>
