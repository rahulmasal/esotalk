<!DOCTYPE html>
<html>
<head>
<%- include('partials/head') %>
</head>
<body class='forum-index'>
<div id='messages'></div>
<div id='wrapper'>

<%- include('partials/header') %>

<div id='body'>
<div id='body-content'>

<div class='sheet active' style='margin:40px auto; width:470px;'>
    <h3 style='padding:10px 15px;'>Delete Account</h3>
    <div class='section'>
        <div class='message warning'>
            <strong>This action is permanent and cannot be undone.</strong><br>
            All your posts, messages, bookmarks, and drafts will be permanently deleted.
        </div>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class='message warning'><%= error %></div>
        <% } %>
        <form action='/auth/delete-account' method='POST'>
            <p style='color:#888;'>Type <strong>DELETE</strong> to confirm:</p>
            <ul class='form'>
                <li>
                    <input type='text' name='confirmation' placeholder='DELETE' required style='text-align:center;'>
                </li>
            </ul>
            <div class='buttons'>
                <button type='submit' class='button submit' style='background:#c00; color:#fff;'>Permanently Delete My Account</button>
                <a href='/' class='button'>Cancel</a>
            </div>
        </form>
    </div>
</div>

</div>
</div>

<%- include('partials/footer') %>

</div>
</body>
</html>
