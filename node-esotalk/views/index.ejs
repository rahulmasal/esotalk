<!DOCTYPE html>
<html>
<head>
<%- include('partials/head') %>
</head>
<body class='forum-index'>
<div id='messages'></div>
<div id='wrapper'>

<%- include('partials/header') %>

<div id='body'>
<div id='body-content'>
<div class='bodyHeader'>
<h1>Discussions</h1>
</div>

<% if (typeof conversations !== 'undefined' && conversations.length > 0) { %>
  <ul class='conversationList list' id='conversations'>
    <% conversations.forEach(conv => { %>
      <li class='hasControls<% if (conv.isPinned) { %> pinned<% } %>'>
        <div class='col-star'>
          <% if (conv.isPinned) { %><i class='icon-star star'></i><% } %>
        </div>
        <div class='col-conversation'>
          <span class='title'>
            <a href='/conversation/<%= conv.slug %>'><%= conv.title %></a>
          </span>
          <span class='action'>
            <span class='name'><%= conv.startUser ? conv.startUser.username : 'Unknown' %></span>
            started <%= typeof timeAgo === 'function' ? timeAgo(conv.createdAt) : new Date(conv.createdAt).toLocaleDateString() %>
          </span>
        </div>
        <div class='col-channel'>
          <% if (conv.Channel) { %>
            <a class='channel' href='/channels/<%= conv.Channel.slug %>'><%= conv.Channel.name %></a>
          <% } %>
        </div>
      </li>
    <% }); %>
  </ul>
<% } else { %>
  <div class='area'>
    <div style='text-align:center; padding:40px 20px; color:#888;'>
      <h3 style='font-weight:300; margin-bottom:10px;'>Welcome to <strong>esoTalk Plus</strong></h3>
      <p>No conversations yet. <% if (typeof user !== 'undefined' && user) { %>Be the first to <a href='/conversation/start'>start one</a>!<% } else { %><a href='/auth/login'>Log in</a> to get started.<% } %></p>
    </div>
  </div>
<% } %>

</div>
</div>

<%- include('partials/footer') %>

</div>

<script src='/js/lib/jquery.js'></script>
<script src='/socket.io/socket.io.js'></script>
<script src='/js/global.js'></script>
<script src='/js/app.js'></script>
</body>
</html>
