<!DOCTYPE html>
<html>
<head>
<meta charset='utf-8'>
<title><%= title %></title>
<link rel="stylesheet" href="/css/base.css">
</head>

<body class='forum-index'>

<div id='messages'>
  <!-- Flash messages will go here -->
</div>

<div id='wrapper'>

<!-- HEADER -->
<div id='hdr'>
<div id='hdr-content'>

<div id='hdr-inner'>

<h1 id='forumTitle'><a href='/'><%= title %></a></h1>

<ul id='mainMenu' class='menu'>
  <li><a href="/">Discussions</a></li>
  <li><a href="/channels">Channels</a></li>
</ul>

<ul id='userMenu' class='menu'>
  <li><a href="/login" class="link-login">Log In</a></li>
  <li><a href="/signup" class="link-signup">Sign Up</a></li>
  <li><a href='/conversation/start' class='link-newConversation button'>New Conversation</a></li>
</ul>

</div>
</div>
</div>

<!-- BODY -->
<div id='body'>
<div id='body-content'>
  <div class="welcome-message">
    <h2>Welcome to the Node.js version of esoTalk!</h2>
    <p>This is the upgraded version running on Express.js.</p>
  </div>
</div>
</div>

<!-- FOOTER -->
<div id='ftr'>
<div id='ftr-content'>
<ul class='menu'>
<li id='goToTop'><a href='#'>Go to top</a></li>
</ul>
</div>
</div>

</div>

</body>
</html>
