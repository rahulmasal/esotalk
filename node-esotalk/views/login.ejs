<!DOCTYPE html>
<html>
<head>
<%- include('partials/head') %>
</head>
<body class='forum-index'>
<div id='messages'></div>
<div id='wrapper'>

<%- include('partials/header') %>

<div id='body'>
<div id='body-content'>

<div class='sheet active' style='margin:40px auto; width:470px;'>
  <h3 style='padding:10px 15px;'>Log In</h3>
  <div class='section'>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class='message warning'><%= error %></div>
    <% } %>

    <form action='/auth/login' method='POST'>
      <ul class='form'>
        <li>
          <label>Email</label>
          <input type='email' name='email' placeholder='Email Address' required>
        </li>
        <li>
          <label>Password</label>
          <input type='password' name='password' placeholder='Password' required>
        </li>
      </ul>
      <div class='buttons'>
        <button type='submit' class='button submit' style='background:#364159; color:#fff;'>Log In</button>
        <small><a href='/auth/forgot-password'>Forgot your password?</a></small>
      </div>
    </form>
  </div>
  <div class='section' style='text-align:center; border-top:1px solid #e5e5e5;'>
    <p style='color:#888; margin-bottom:10px;'>Or log in using:</p>
    <a href='/auth/google' class='button' style='margin:3px;'>Google</a>
    <a href='/auth/github' class='button' style='margin:3px;'>GitHub</a>
  </div>
</div>

</div>
</div>

<%- include('partials/footer') %>

</div>
</body>
</html>
